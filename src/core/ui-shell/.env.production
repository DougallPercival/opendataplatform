# Committed, unlike a plain .env — Vite auto-loads this during `vite build`
# (production mode by default) and it's baked into the built JS bundle, the
# same "cluster-constant value committed directly, fork this repo to point
# at your own" convention every other hardcoded URL in this repo already
# follows (gateway.yaml's catalog-service URL, every :dev image tag). See
# the root .gitignore's ui-shell exceptions for why this file (and
# .env.example) are deliberately NOT swept up by the repo-wide .env.*
# ignore rule that applies to everything else.

VITE_KEYCLOAK_URL=https://keycloak.platform.local
VITE_KEYCLOAK_REALM=platform
VITE_KEYCLOAK_CLIENT_ID=platform-ui-shell
